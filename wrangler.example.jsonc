{
  // Cloudflare Worker Configuration
  "name": "cloudflare-access-error-page",
  "main": "main.js",
  "compatibility_date": "2024-01-01",

  // Your Cloudflare Account ID (set via CLI: wrangler deploy --account-id=YOUR_ID)
  // "account_id": "your-account-id-here",

  // Route configuration — the pattern must cover the page and its /api/* and /scripts/* paths
  "routes": [
    {
      "pattern": "access.example.com/cf-access*",
      "zone_name": "example.com"
    }
  ],

  // Environment variables (use wrangler secret put for sensitive values)
  // For the Access error page:
  //   - BEARER_TOKEN: API token with Access: Apps & Policies Read, Access: Audit Logs Read,
  //     Zero Trust Devices Read, and Device Posture Read permissions
  "vars": {}
}
