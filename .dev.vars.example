# Local development environment variables
# Copy this file to .dev.vars and fill in your actual values
# .dev.vars is gitignored and will never be committed

# API token used to resolve why the user was denied — optional.
# Create it at https://dash.cloudflare.com/profile/api-tokens/create with:
#   Account -> Access: Apps and Policies -> Read
#   Account -> Access: Audit Logs -> Read
#   Account -> Zero Trust: Devices -> Read
#   Device Posture -> Read
# Without it, the page still works but shows a generic (limited) reason.
BEARER_TOKEN=
