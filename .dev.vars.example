# Local development environment variables
# Copy this file to .dev.vars and fill in your actual values
# .dev.vars is gitignored and will never be committed

# API token used to resolve why the user was denied
# (Access: Apps and Policies Read, Access: Audit Logs Read,
#  Zero Trust: Devices Read, Device Posture Read — see README)
BEARER_TOKEN=your_api_token_here
